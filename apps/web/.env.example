# Firebase web app config (Firebase console > Project settings > Your apps).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=

# Cloud Run URL of apps/parser.
NEXT_PUBLIC_PARSER_URL=http://localhost:8080

# Optional: a Google Maps Platform key restricted to the Places API (New) and
# to this app's origins (HTTP referrers). With it, the booking form offers
# places as you type an address or postcode; without it the field is plain.
#NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Optional: the public half of the parser's VAPID key pair
# (`npx web-push generate-vapid-keys`). With it, Settings offers reminders
# as notifications in the browser; without it the switch is hidden.
#NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Optional: the domain of the forwarding addresses the parser issues (its
# FORWARD_DOMAIN). With it, Settings offers an address to forward booking
# emails to; without it the section is hidden.
#NEXT_PUBLIC_FORWARD_DOMAIN=

# Local development against the Firebase emulators (firebase emulators:start).
#NEXT_PUBLIC_AUTH_EMULATOR_URL=http://localhost:9099
#NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=localhost:8081
