{
  "name": "@travelmo/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node sw.build.mjs && next build",
    "start": "next start",
    "icons": "node scripts/icons.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "firebase emulators:exec --only firestore --project demo-travelmo --config ../../firebase.json 'vitest run'",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-travelmo --config ../../firebase.json 'playwright test'",
    "worldmap": "node scripts/worldmap.mjs"
  },
  "dependencies": {
    "@travelmo/core": "workspace:*",
    "firebase": "^13.1.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.27.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.2",
    "i18n-iso-countries": "7.14.0",
    "serwist": "9.5.13",
    "tailwindcss": "^4",
    "topojson-client": "3.1.0",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "world-atlas": "2.0.2"
  }
}
