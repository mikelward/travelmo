<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: the instrumented tests reach the Firebase emulators
     on the host over plain HTTP, which Android refuses by default for an app
     targeting API 28 or later. The release manifest carries no such config. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application android:networkSecurityConfig="@xml/network_security_config" />

</manifest>
