<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext only to the Android emulator's alias for the host machine,
     where the Firebase emulators listen during the instrumented tests
     (scripts/connected-tests.sh); everything else keeps the platform default. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
