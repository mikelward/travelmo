<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      A framework theme, not a Material XML one: the UI is Compose, so the
      XML theme only gives the window its color before the first composition.
      values-night/colors.xml supplies the dark background.
    -->
    <style name="Theme.Travelmo" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
