rules_version = '2';

// The parser worker uses the Admin SDK and bypasses these rules; they govern
// the web and future mobile clients only.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Signed in to an account that has not been deleted. A sign-in token
    // stays valid for up to an hour after its account is deleted, so every
    // create and update also checks the deletion marker (SPEC "Deleting an
    // account"); deletes stay allowed, since they only remove data.
    function active() {
      return signedIn() && !exists(/databases/$(database)/documents/deletedAccounts/$(request.auth.uid));
    }

    // Approval (SPEC "Access"; packages/core/src/access.ts decides the
    // same). An account is approved when it is an admin's, when it has a
    // user document (every account made before approvals has one, and a
    // new one may make it only once approved) or when its verified email's
    // record is approved by an admin or by someone sharing with it, unless
    // an admin declined or revoked that address.
    function verifiedEmail() {
      return request.auth.token.email != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function accessPath(email) {
      return /databases/$(database)/documents/access/$(email);
    }
    function configPath() {
      return /databases/$(database)/documents/config/access;
    }
    function admins() {
      return get(configPath()).data.get('admins', []);
    }
    // The addresses the account confirmed besides its sign-in (SPEC "Linked
    // email addresses"): `confirmed` in its private record, and the Gmail
    // mailbox it connected, whose consent proved the address is the user's.
    // Both were always out of clients' reach; the user document's `emails`
    // copy is not trusted, as the rules before let a client write it. Read
    // only when the sign-in address does not already answer, so the common
    // case costs nothing.
    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function linksPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid)/private/emails;
    }
    function linkedEmails() {
      return signedIn() ? confirmedEmails().concat(mailboxEmails()).concat(gmailEmail()) : [];
    }
    // The connected Gmail mailboxes, as the parser recorded them beside the
    // confirmed addresses; never the user document's `gmails`, a copy for
    // the apps that clients could write before these rules locked it.
    function mailboxEmails() {
      return exists(linksPath()) ? get(linksPath()).data.get('mailboxes', []) : [];
    }
    // A mailbox connected before there could be several, until the parser
    // moves it; clients could never write `gmail`.
    function confirmedEmails() {
      return exists(linksPath()) ? get(linksPath()).data.get('confirmed', []) : [];
    }
    function gmailEmail() {
      return exists(userPath()) ? [get(userPath()).data.get(['gmail', 'emailAddress'], '').lower()] : [];
    }
    // Whether one of the account's addresses is in the list: the verified
    // sign-in first, then those it linked. Written with the list on the
    // left of `hasAny`, the one form a query's filter can satisfy, so the
    // same check serves reads and `array-contains-any` queries.
    function anyMine(list) {
      return (verifiedEmail() && myEmail() in list) || list.hasAny(linkedEmails());
    }
    function isAdmin() {
      return signedIn() && exists(configPath()) && admins() is list && anyMine(admins());
    }
    function hasProfile() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function hasRecord() {
      return verifiedEmail() && exists(accessPath(myEmail()));
    }
    function myRecord() {
      return get(accessPath(myEmail())).data;
    }
    function declined() {
      return hasRecord() && myRecord().get('status', '') == 'declined';
    }
    function approvedByRecord() {
      return hasRecord() && (myRecord().get('status', '') == 'approved' || 'invitedBy' in myRecord());
    }
    function approved() {
      return signedIn() && (isAdmin() || (!declined() && (approvedByRecord() || hasProfile())));
    }
    // Approved and not deleted: what every create and update needs.
    function member() {
      return active() && approved();
    }

    function isOwner(trip) {
      return trip.ownerUid == request.auth.uid;
    }

    // Sharing is by verified email, the sign-in's or one the account linked.
    function isSharee(trip) {
      return signedIn() && anyMine(trip.sharedWith);
    }

    // Someone the owner of a travel profile trusts with it, by verified email.
    function isTrusted(profile) {
      return signedIn() && anyMine(profile.get('trustedEmails', []));
    }

    function isDate(value) {
      return value is string && value.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }

    // A reminder before a trip (packages/core/src/checklist.ts), one per
    // document: an id, its words and a lead time, or, for a one-off on one
    // trip, a date instead. A missing field or one of the wrong type fails
    // the check with an error.
    function validReminder(r, dated) {
      return r.keys().hasOnly(['id', 'text', 'amount', 'unit', 'date', 'createdAt'])
        && r.id.matches('[A-Za-z0-9_-]{1,40}')
        && r.text is string && r.text.size() > 0 && r.text.size() <= 200
        && r.createdAt is string
        && ('date' in r
          ? dated && !('amount' in r) && !('unit' in r) && isDate(r.date)
          : r.amount is int && r.amount >= 0 && r.amount <= {'days': 365, 'weeks': 52, 'months': 12}[r.unit]);
    }

    function validTrip(trip) {
      return trip.keys().hasOnly(['id', 'title', 'start', 'end', 'liveStart', 'liveEnd', 'ownerUid', 'sharedWith', 'deleting', 'cancelledAt', 'allCancelled', 'localOnly', 'travelers', 'setting', 'removedTravelers', 'createdAt', 'updatedAt'])
        && (!('deleting' in trip) || trip.deleting is bool)
        // What the list's filters need of its bookings (listFilters.ts).
        && (!('allCancelled' in trip) || trip.allCancelled is bool)
        && (!('localOnly' in trip) || trip.localOnly is bool)
        && (!('travelers' in trip) || (trip.travelers is list && trip.travelers.size() <= 100))
        // Names the owner took off the trip (Travelers…); a sharee may not.
        && (!('removedTravelers' in trip) || (trip.removedTravelers is list && trip.removedTravelers.size() <= 100))
        // What kind of place it goes to, for its picture (tripSetting).
        && (!('setting' in trip) || trip.setting in ['city', 'town', 'beach', 'mountains', 'lake', 'countryside', 'activity', 'other', 'car_rental', 'none'])
        && (!('cancelledAt' in trip) || (trip.cancelledAt is string && trip.cancelledAt.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}.*')))
        && trip.title is string && trip.title.size() > 0 && trip.title.size() <= 200
        && isDate(trip.start) && isDate(trip.end) && trip.start <= trip.end
        // When the person now travels, within the trip's own dates; both or neither.
        && (('liveStart' in trip) == ('liveEnd' in trip))
        && (!('liveStart' in trip) || (isDate(trip.liveStart) && isDate(trip.liveEnd)
            && trip.start <= trip.liveStart && trip.liveStart <= trip.liveEnd && trip.liveEnd <= trip.end))
        && trip.sharedWith is list && trip.sharedWith.size() <= 20
        && trip.createdAt is string && trip.updatedAt is string;
    }

    match /trips/{tripId} {
      // A missing trip reads as absent rather than forbidden, so a client can
      // tell a deleted trip from one it may not see.
      allow read: if approved() && (resource == null || isOwner(resource.data) || isSharee(resource.data));
      allow create: if member()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.id == tripId
        && validTrip(request.resource.data);
      allow update: if member()
        && isOwner(resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.id == tripId
        && validTrip(request.resource.data);
      // A sharee adding or restoring a booking may only widen the trip's own
      // dates to hold it; those it is shown with stay within them, and may
      // move in when the sharee marks a booking at its end cancelled. The
      // list's flags follow the bookings, which a sharee may change too.
      allow update: if member()
        && isSharee(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['start', 'end', 'liveStart', 'liveEnd', 'allCancelled', 'localOnly', 'travelers', 'setting', 'updatedAt'])
        && request.resource.data.start <= resource.data.start
        && request.resource.data.end >= resource.data.end
        && validTrip(request.resource.data);
      allow delete: if approved() && isOwner(resource.data);

      match /segments/{segmentId} {
        function trip() {
          return get(/databases/$(database)/documents/trips/$(tripId)).data;
        }
        function isInstant(value) {
          return value is string && value.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}.*');
        }
        function validSegment(segment) {
          return segment.keys().hasOnly(['id', 'tripId', 'type', 'title', 'provider', 'confirmation', 'start', 'end',
              'origin', 'destination', 'notes', 'rentalStage', 'source', 'gmailMessageIds', 'sources', 'sender', 'rating', 'favorite',
              'cancelledAt', 'cancelledBy', 'cancelledSentAt', 'restoredFrom', 'restoredAt', 'userCancelled', 'travelers', 'editedAt', 'mergedFrom', 'mergedBookings', 'createdAt', 'updatedAt'])
            && segment.id == segmentId && segment.tripId == tripId
            && segment.type in ['flight', 'train', 'bus', 'ferry', 'lodging', 'car_rental', 'activity', 'other']
            && segment.title is string && segment.title.size() > 0 && segment.title.size() <= 200
            && isInstant(segment.start)
            && (!('end' in segment) || isInstant(segment.end))
            && segment.source in ['gmail', 'manual', 'tripit', 'ics', 'forward', 'fastmail', 'imap']
            && segment.gmailMessageIds is list
            && (!('sources' in segment) || segment.sources is list)
            && (!('rating' in segment) || (segment.rating is int && segment.rating >= 1 && segment.rating <= 5))
            && (!('favorite' in segment) || segment.favorite is bool)
            && (!('cancelledAt' in segment) || isInstant(segment.cancelledAt))
            && (!('cancelledBy' in segment) || (segment.cancelledBy is string && segment.cancelledBy.size() > 0))
            && (!('cancelledSentAt' in segment) || isInstant(segment.cancelledSentAt))
            && (!('restoredFrom' in segment) || (segment.restoredFrom is list && segment.restoredFrom.size() <= 50))
            && (!('restoredAt' in segment) || isInstant(segment.restoredAt))
            && (!('travelers' in segment) || (segment.travelers is list && segment.travelers.size() <= 20))
            && (!('userCancelled' in segment) || (segment.userCancelled in ['booking', 'trip'] && 'cancelledAt' in segment))
            && (!('editedAt' in segment) || isInstant(segment.editedAt))
            && (!('mergedFrom' in segment) || (segment.mergedFrom is list && segment.mergedFrom.size() <= 50))
            && (!('mergedBookings' in segment) || (segment.mergedBookings is list && segment.mergedBookings.size() <= 50))
            && (!('rentalStage' in segment) || segment.rentalStage in ['reservation', 'agreement', 'paired'])
            && segment.createdAt is string && segment.updatedAt is string;
        }
        // A change to a booking's details is a hand edit, which records when
        // (`editedAt`): "Refresh from email" leaves an edited booking alone,
        // and can tell one only rated, marked or moved from one edited.
        function recordsEdit() {
          return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['type', 'title', 'provider', 'confirmation',
              'start', 'end', 'origin', 'destination', 'notes'])
            || request.resource.data.diff(resource.data).affectedKeys().hasAny(['editedAt']);
        }
        function editor() {
          return isOwner(trip()) || isSharee(trip());
        }
        function canEdit() {
          return approved() && editor();
        }
        // member() already checks approval: checking it again in canEdit()
        // would spend twice the expressions a request may evaluate (1,000)
        // on an account with linked addresses.
        allow read: if canEdit();
        allow create: if member() && editor()
          && trip().get('deleting', false) == false
          && validSegment(request.resource.data);
        allow update: if member() && editor()
          && trip().get('deleting', false) == false
          && validSegment(request.resource.data)
          && recordsEdit();
        allow delete: if canEdit();
      }
    }

    match /users/{uid} {
      function isSelf() {
        return signedIn() && request.auth.uid == uid;
      }
      // `gmail`, `gmails`, `fastmail`, `imaps`, `googleCalendar`, `forward`,
      // `emails` and `pendingEmails` are written by the server; clients may
      // not forge a connection, a forwarding address or a linked email
      // address.
      function serverKeys() {
        return ['gmail', 'gmails', 'fastmail', 'imaps', 'googleCalendar', 'forward', 'emails', 'pendingEmails', 'refresh'];
      }
      // Corrections to where home was (Profile), and the airports chosen for
      // each home: lists of at most fifty.
      // Rules cannot check each entry; the parser parses them and ignores a
      // list that does not parse.
      function validHomes(data) {
        return (!('homes' in data) || (data.homes is list && data.homes.size() <= 50))
          && (!('homeAirports' in data) || (data.homeAirports is list && data.homeAirports.size() <= 50));
      }
      // The user's own car and ride companies (Settings), the ride
      // suggestions they hid and the trips they said go one way: lists of at
      // most twenty, two hundred and two hundred. The app parses each entry
      // and leaves out one that does not parse, so a link that is not
      // https:// is never shown.
      function validRides(data) {
        return (!('rideCompanies' in data) || (data.rideCompanies is list && data.rideCompanies.size() <= 20))
          && (!('hiddenRideNeeds' in data) || (data.hiddenRideNeeds is list && data.hiddenRideNeeds.size() <= 200))
          && (!('oneWayTrips' in data) || (data.oneWayTrips is list && data.oneWayTrips.size() <= 200));
      }
      // Readable to its owner even before approval: the app reads it to
      // tell an account from before approvals from a new one.
      allow read: if isSelf();
      allow create: if member() && isSelf() && !request.resource.data.keys().hasAny(serverKeys())
        && validHomes(request.resource.data) && validRides(request.resource.data);
      allow update: if member() && isSelf()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverKeys())
        && validHomes(request.resource.data) && validRides(request.resource.data);

      // The people the user's bookings name (SPEC "Travelers"): imports add
      // and count them; the owner renames them, says which is them, and
      // merges two who are one (the other deleted, its spellings kept).
      match /people/{personId} {
        allow read: if isSelf() && approved();
        allow delete: if member() && isSelf();
        allow update: if member() && isSelf()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'aliases', 'me', 'updatedAt'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200
          && request.resource.data.aliases is list && request.resource.data.aliases.size() <= 50
          && (!('me' in request.resource.data) || request.resource.data.me is bool)
          && request.resource.data.updatedAt is string;
      }

      // Reminders before every international trip (Settings), one per
      // slot, s0 to s19, so there are at most twenty.
      match /tripReminders/{slot} {
        allow read, delete: if isSelf() && approved();
        allow create, update: if member() && isSelf()
          && slot.matches('s([0-9]|1[0-9])')
          && validReminder(request.resource.data, false);
      }

      // The user's own state for one trip's reminders before it: which they
      // ticked off (at most forty ids) and, one per slot a0 to a9, the
      // one-offs they added to it. Theirs alone, whether the trip is theirs
      // or shared with them.
      match /tripChecklists/{tripId} {
        allow read, delete: if isSelf() && approved();
        allow create, update: if member() && isSelf()
          && request.resource.data.keys().hasOnly(['done', 'updatedAt'])
          && request.resource.data.done is list
          && request.resource.data.done.size() <= 40
          && request.resource.data.updatedAt is string;

        match /added/{slot} {
          allow read, delete: if isSelf() && approved();
          allow create, update: if member() && isSelf()
            && slot.matches('a[0-9]')
            && validReminder(request.resource.data, true);
        }
      }

      // The flights the user marked "I've checked in" on one trip, by
      // booking id, at most a hundred: theirs alone, whether the trip is
      // theirs or shared with them. The parser reads it to skip their
      // check-in reminders.
      match /checkedIn/{tripId} {
        allow read, delete: if isSelf() && approved();
        allow create, update: if member() && isSelf()
          && request.resource.data.keys().hasOnly(['segmentIds', 'updatedAt'])
          && request.resource.data.segmentIds is list
          && request.resource.data.segmentIds.size() <= 100
          && request.resource.data.updatedAt is string;
      }

      // What the parser has sent as reminders: nobody's to read or write.
      match /reminders/{tripId} {
        allow read, write: if false;
      }

      // A browser's push subscription, written by that browser: the
      // endpoint the push service gave it and the keys that encrypt to it.
      match /pushSubscriptions/{id} {
        allow read, delete: if isSelf() && approved();
        allow create, update: if member() && isSelf()
          && request.resource.data.keys().hasOnly(['endpoint', 'keys', 'createdAt'])
          && request.resource.data.endpoint is string
          && request.resource.data.endpoint.matches('https://.*')
          && request.resource.data.endpoint.size() <= 2048
          && request.resource.data.keys.keys().hasOnly(['p256dh', 'auth'])
          && request.resource.data.keys.p256dh is string
          && request.resource.data.keys.auth is string
          && request.resource.data.createdAt is string;
      }

      // A phone's Cloud Messaging registration, written by the app on that
      // phone: the token the parser sends to, and nothing else.
      match /devices/{id} {
        allow read, delete: if isSelf() && approved();
        allow create, update: if member() && isSelf()
          && request.resource.data.keys().hasOnly(['token', 'platform', 'createdAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.token.size() <= 4096
          && request.resource.data.platform == 'android'
          && request.resource.data.createdAt is string;
      }

      // The traveler's profile (documents, loyalty numbers): the parser writes
      // what was imported; the owner alone chooses, by verified email, who
      // else may read it, and nobody else writes anything.
      match /travelProfile/{document} {
        function trustedList(list) {
          return list is list && list.size() <= 20;
        }
        allow read: if approved() && (isSelf() || isTrusted(resource.data));
        allow create: if member() && isSelf() && document == 'main'
          && request.resource.data.keys().hasOnly(['ownerUid', 'ownerEmail', 'trustedEmails', 'updatedAt'])
          && request.resource.data.ownerUid == uid
          && (!('ownerEmail' in request.resource.data) || request.resource.data.ownerEmail == request.auth.token.email.lower())
          && trustedList(request.resource.data.trustedEmails);
        // The owner may also remove what emails showed (`foundLoyalty`, at
        // most 2,000, packages/core's maxFoundLoyalty, a bound from the
        // 1 MiB document limit; the parser adds to it) and say whose each membership
        // is (`loyaltyPeople`, at most a hundred).
        allow update: if member() && isSelf()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trustedEmails', 'foundLoyalty', 'loyaltyPeople', 'updatedAt'])
          && (!('loyaltyPeople' in request.resource.data) || (request.resource.data.loyaltyPeople is list && request.resource.data.loyaltyPeople.size() <= 100))
          // A profile an import started may have no sharing list yet.
          && (!('trustedEmails' in request.resource.data) || trustedList(request.resource.data.trustedEmails))
          && (!('foundLoyalty' in request.resource.data) || (request.resource.data.foundLoyalty is list && request.resource.data.foundLoyalty.size() <= 2000));
      }

      match /settings/{document} {
        allow read, write: if isSelf() && approved();
      }
      match /parsedMessages/{messageId} {
        allow read: if isSelf() && approved();
      }
      // Feed links carry secrets: the owner reads them, the parser alone
      // writes them, after checking the address.
      match /feeds/{feedId} {
        allow read: if isSelf() && approved();
        allow write: if false;
      }
      // The calendar export link is a secret: the owner reads it, the parser
      // alone issues or withdraws it.
      match /calendarExport/{document} {
        allow read: if isSelf() && approved();
        allow write: if false;
      }
      // Refresh tokens live here; only the Admin SDK touches it.
      match /private/{document} {
        allow read, write: if false;
      }
    }

    // Lets someone list the profiles shared with them (a collection-group
    // query on trustedEmails); each result is checked like a direct read.
    // Queries are checked against their filter, so this rule names the
    // field directly; the client asks with its own (lowercase) addresses.
    match /{path=**}/travelProfile/{document} {
      allow get: if approved() && isTrusted(resource.data);
      allow list: if approved() && anyMine(resource.data.trustedEmails);
    }

    // Who may use the app, one record per lowercased verified email
    // (packages/core/src/access.ts).
    match /access/{email} {
      function isMine() {
        return signedIn() && verifiedEmail() && myEmail() == email;
      }
      function decisionKeys() {
        return ['status', 'approvedBy', 'approvedAt', 'declinedBy', 'declinedAt'];
      }
      // Approving sets who and when; declining too, and never for an admin,
      // so no admin locks out another or themselves.
      function validDecision(data) {
        return (data.status == 'approved' && data.approvedBy == request.auth.uid && data.approvedAt is string)
          || (data.status == 'declined' && data.declinedBy == request.auth.uid && data.declinedAt is string
            && !(email in admins()));
      }
      allow get: if isMine() || isAdmin();
      allow list: if isAdmin();

      // Nobody asks for access: Travelmo is invite-only (an admin's invite
      // or someone sharing with the address, below).

      // An account from before approvals records itself, so admins see it
      // and can revoke it.
      allow create: if member() && isMine() && hasProfile()
        && request.resource.data.keys().hasOnly(['email', 'status', 'uid', 'approvedBy', 'approvedAt'])
        && request.resource.data.email == email
        && request.resource.data.status == 'approved'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.approvedBy == request.auth.uid
        && request.resource.data.approvedAt is string;

      // Sharing a trip or a profile with an address invites it: any approved
      // user may, as anyone may already share with any address. An admin's
      // decline still wins.
      allow create: if member()
        && request.resource.data.keys().hasOnly(['email', 'invitedBy', 'invitedAt'])
        && request.resource.data.email == email
        && request.resource.data.invitedBy == request.auth.uid
        && request.resource.data.invitedAt is string;
      allow update: if member()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['invitedBy', 'invitedAt'])
        && request.resource.data.invitedBy == request.auth.uid
        && request.resource.data.invitedAt is string;

      // Admins approve, decline, invite and revoke.
      allow create: if member() && isAdmin()
        && request.resource.data.keys().hasOnly(['email'].concat(decisionKeys()))
        && request.resource.data.email == email
        && validDecision(request.resource.data);
      allow update: if member() && isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(decisionKeys())
        && validDecision(request.resource.data);
    }

    // Settings kept by hand in the console; `config/access` lists the
    // admins and is readable by them alone, so the app can tell who is one.
    match /config/{document} {
      allow get: if document == 'access' && signedIn() && anyMine(resource.data.get('admins', []));
      allow list, write: if false;
    }

    // Export-link token hashes to their owner: the parser's alone.
    match /calendarExports/{tokenHash} {
      allow read, write: if false;
    }

    // Deleted accounts' markers, which stop imports recreating their data:
    // the parser's alone.
    match /deletedAccounts/{uid} {
      allow read, write: if false;
    }
    // Forwarding-address token hashes to their owner: the parser's alone.
    match /forwardAddresses/{tokenHash} {
      allow read, write: if false;
    }
    // Which account an address is linked to, one each, and the hashes of
    // the links that confirm one: the parser's alone.
    match /linkedEmails/{email} {
      allow read, write: if false;
    }

    match /gmailAccounts/{emailAddress} {
      allow read, write: if false;
    }
    match /oauthStates/{nonce} {
      allow read, write: if false;
    }
    match /pendingConnections/{token} {
      allow read, write: if false;
    }
    // A flight's live gates and carousel, one per flight and shared by
    // everyone booked on it: public flight data, read by the id a booking
    // names (never listed, so nobody learns which flights others take);
    // the parser alone writes them and their daily budget.
    match /flightStatus/{key} {
      allow get: if signedIn();
      allow list, write: if false;
    }
    match /flightStatusBudget/{day} {
      allow read, write: if false;
    }
    match /flightStatusClaims/{key} {
      allow read, write: if false;
    }
    match /flightStatusNews/{id} {
      allow read, write: if false;
    }
    // Who was reminded that a booking's online check-in is open.
    match /checkInReminders/{id} {
      allow read, write: if false;
    }
    // Whether a reminder before a trip went to its user.
    match /checklistReminders/{id} {
      allow read, write: if false;
    }
    // Copies of the bug reports users sent: the parser's alone, never even
    // the reporter's.
    match /bugReports/{id} {
      allow read, write: if false;
    }
    // The geocoder's cache and daily budget: the parser's alone.
    match /geocodes/{key} {
      allow read, write: if false;
    }
    match /geocodeBudget/{day} {
      allow read, write: if false;
    }
    match /geocodeRetries/{id} {
      allow read, write: if false;
    }
    match /geocodeBackfill/{id} {
      allow read, write: if false;
    }
  }
}
