rules_version = '2';

// The parser worker uses the Admin SDK and bypasses these rules; they govern
// the web and future mobile clients only.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(trip) {
      return trip.ownerUid == request.auth.uid;
    }

    // Sharing is by verified email so no user lookup is needed.
    function isSharee(trip) {
      return request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in trip.sharedWith;
    }

    // Someone the owner of a travel profile trusts with it, by verified email.
    function isTrusted(profile) {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && profile.get('trustedEmails', []) is list
        && request.auth.token.email.lower() in profile.get('trustedEmails', []);
    }

    function isDate(value) {
      return value is string && value.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }

    function validTrip(trip) {
      return trip.keys().hasOnly(['id', 'title', 'start', 'end', 'ownerUid', 'sharedWith', 'deleting', 'createdAt', 'updatedAt'])
        && (!('deleting' in trip) || trip.deleting is bool)
        && trip.title is string && trip.title.size() > 0 && trip.title.size() <= 200
        && isDate(trip.start) && isDate(trip.end) && trip.start <= trip.end
        && trip.sharedWith is list && trip.sharedWith.size() <= 20
        && trip.createdAt is string && trip.updatedAt is string;
    }

    match /trips/{tripId} {
      // A missing trip reads as absent rather than forbidden, so a client can
      // tell a deleted trip from one it may not see.
      allow read: if signedIn() && (resource == null || isOwner(resource.data) || isSharee(resource.data));
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.id == tripId
        && validTrip(request.resource.data);
      allow update: if signedIn()
        && isOwner(resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.id == tripId
        && validTrip(request.resource.data);
      // A sharee adding a booking may only widen the dates to hold it.
      allow update: if signedIn()
        && isSharee(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['start', 'end', 'updatedAt'])
        && request.resource.data.start <= resource.data.start
        && request.resource.data.end >= resource.data.end
        && validTrip(request.resource.data);
      allow delete: if signedIn() && isOwner(resource.data);

      match /segments/{segmentId} {
        function trip() {
          return get(/databases/$(database)/documents/trips/$(tripId)).data;
        }
        function isInstant(value) {
          return value is string && value.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}.*');
        }
        function validSegment(segment) {
          return segment.keys().hasOnly(['id', 'tripId', 'type', 'title', 'provider', 'confirmation', 'start', 'end',
              'origin', 'destination', 'notes', 'source', 'gmailMessageIds', 'sources', 'sender', 'rating', 'favorite',
              'createdAt', 'updatedAt'])
            && segment.id == segmentId && segment.tripId == tripId
            && segment.type in ['flight', 'train', 'bus', 'ferry', 'lodging', 'car_rental', 'activity', 'other']
            && segment.title is string && segment.title.size() > 0 && segment.title.size() <= 200
            && isInstant(segment.start)
            && (!('end' in segment) || isInstant(segment.end))
            && segment.source in ['gmail', 'manual', 'tripit', 'ics']
            && segment.gmailMessageIds is list
            && (!('sources' in segment) || segment.sources is list)
            && (!('rating' in segment) || (segment.rating is int && segment.rating >= 1 && segment.rating <= 5))
            && (!('favorite' in segment) || segment.favorite is bool)
            && segment.createdAt is string && segment.updatedAt is string;
        }
        function canEdit() {
          return signedIn() && (isOwner(trip()) || isSharee(trip()));
        }
        allow read: if canEdit();
        allow create, update: if canEdit()
          && trip().get('deleting', false) == false
          && validSegment(request.resource.data);
        allow delete: if canEdit();
      }
    }

    match /users/{uid} {
      function isSelf() {
        return signedIn() && request.auth.uid == uid;
      }
      // `gmail` and `googleCalendar` are written by the server; clients may
      // not forge a connection.
      allow read: if isSelf();
      allow create: if isSelf() && !request.resource.data.keys().hasAny(['gmail', 'googleCalendar']);
      allow update: if isSelf()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['gmail', 'googleCalendar']);

      // What the parser has mailed as reminders: nobody's to read or write.
      match /reminders/{tripId} {
        allow read, write: if false;
      }

      // The traveler's profile (documents, loyalty numbers): the parser writes
      // what was imported; the owner alone chooses, by verified email, who
      // else may read it, and nobody else writes anything.
      match /travelProfile/{document} {
        function trustedList(list) {
          return list is list && list.size() <= 20;
        }
        allow read: if isSelf() || isTrusted(resource.data);
        allow create: if isSelf() && document == 'main'
          && request.resource.data.keys().hasOnly(['ownerUid', 'ownerEmail', 'trustedEmails', 'updatedAt'])
          && request.resource.data.ownerUid == uid
          && (!('ownerEmail' in request.resource.data) || request.resource.data.ownerEmail == request.auth.token.email.lower())
          && trustedList(request.resource.data.trustedEmails);
        allow update: if isSelf()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trustedEmails', 'updatedAt'])
          && trustedList(request.resource.data.trustedEmails);
      }

      match /settings/{document} {
        allow read, write: if isSelf();
      }
      match /parsedMessages/{messageId} {
        allow read: if isSelf();
      }
      // Feed links carry secrets: the owner reads them, the parser alone
      // writes them, after checking the address.
      match /feeds/{feedId} {
        allow read: if isSelf();
        allow write: if false;
      }
      // The calendar export link is a secret: the owner reads it, the parser
      // alone issues or withdraws it.
      match /calendarExport/{document} {
        allow read: if isSelf();
        allow write: if false;
      }
      // Refresh tokens live here; only the Admin SDK touches it.
      match /private/{document} {
        allow read, write: if false;
      }
    }

    // Lets someone list the profiles shared with them (a collection-group
    // query on trustedEmails); each result is checked like a direct read.
    // Queries are checked against their filter, so this rule names the
    // field directly; the client asks with its own (lowercase) email.
    match /{path=**}/travelProfile/{document} {
      allow get: if isTrusted(resource.data);
      allow list: if signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in resource.data.trustedEmails;
    }

    // Export-link token hashes to their owner: the parser's alone.
    match /calendarExports/{tokenHash} {
      allow read, write: if false;
    }

    match /gmailAccounts/{emailAddress} {
      allow read, write: if false;
    }
    match /oauthStates/{nonce} {
      allow read, write: if false;
    }
    match /pendingConnections/{token} {
      allow read, write: if false;
    }
    // The geocoder's cache and daily budget: the parser's alone.
    match /geocodes/{key} {
      allow read, write: if false;
    }
    match /geocodeBudget/{day} {
      allow read, write: if false;
    }
    match /geocodeRetries/{id} {
      allow read, write: if false;
    }
  }
}
